<%- include("./includes/head") %> <% if (loginSuccessful) { %>
<p class="success-msg"><%= loginSuccessful %></p>
<% } %>

<section class="header">
  <% if (postsArr.length === 0 && isLogin) { %>
  <div class="no-post-yet">
    <h3>No post yet.</h3>
    <a href="/admin/create-post">Create a new post</a>
  </div>
  <% } %>

  <div class="post-container mb-30">
    <% for (let post of postsArr) { %>
    <div class="post-box">
      <img
        class="post-img"
        src="<%= '/' + post.imgUrl %>"
        alt="<%= post.title %>"
      />
      <a href="/post/<%= post._id %>" class="post-title"><%= post.title %></a>

      <p class="post-desc">
        <%= post.description.substr(0, 100) %><% if (post.description.length >
        80) { %>...<% } %>
      </p>
      <hr />

      <div class="flex-align-center">
        <% if (post.userId._id.toString() == currentUserId.toString()) { %>
        <a href="/admin/profile">
          <% if(post.userId.profile_imgUrl && post.userId.isPremium ){ %> <img
          class="profile-photo-home ml-0" src="<%= "/" +
          post.userId.profile_imgUrl %>" alt="<%= post.userId.username %>" /> <%
          } else { %>
          <span class="material-symbols-outlined material-account-circle-f4">
            account_circle
          </span>
          <% } %>
        </a>
        <% } else if(post.userId._id.toString() !== currentUserId.toString()) {
        %>
        <a href="/profile/<%= post.userId._id %>">
          <% if(post.userId.profile_imgUrl && post.userId.isPremium) {%> <img
          class="profile-photo-home ml-0" src="<%= "/" +
          post.userId.profile_imgUrl %>" alt="<%= post.userId.username %>" /> <%
          } else { %>
          <span class="material-symbols-outlined material-account-circle-f4">
            account_circle
          </span>
          <% } %>
        </a>

        <% } %>
        <div>
          <% if(post.userId.isPremium && !post.userId.username){ %>
          <p class="post-email">
            <%= post.userId.email %>
            <span
              class="material-symbols-outlined icon-down-5 animate__animated animate__heartBeat animate__infinite infinite secondary-color"
              >star
            </span>
          </p>
          <% } else{ %>
          <p class="post-email"><%= post.userId.email %></p>
          <% } %> <% if(post.userId.isPremium && post.userId.username){%>
          <p class="post-email">
            <%= post.userId.username %>
            <span
              class="material-symbols-outlined icon-down-5 animate__animated animate__heartBeat animate__infinite infinite secondary-color"
              >star
            </span>
          </p>
          <%}else{%>
          <p class="post-email"><%= post.userId.username %></p>
          <%}%>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <hr />

  <div class="pagination">
    <!-- previous -->
    <% if (hasPreviousPage) { %>
    <a href="/?page=<%= previousPage %>">Previous Page (<%= previousPage %>)</a>
    <% } %>

    <!-- next -->
    <% if (hasNextPage) { %>
    <a class="ml-10" href="/?page=<%= nextPage %>"
      >Next Page (<%= nextPage %>)</a
    >
    <% } %>
  </div>
</section>

<%- include("./includes/foot") %>

<script>
  // Remove success message after 3 seconds
  setTimeout(() => {
    const successMsg = document.querySelector(".success-msg")
    if (successMsg) {
      successMsg.remove()
    }
  }, 3000)
</script>
