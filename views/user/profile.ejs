<%- include("../includes/head") %>
<section class="profile">
  <div class="user-profile">
    <div>
      <span class="material-symbols-outlined material-account-circle-f6 pl-80">
        account_circle
      </span>
      <p class="profile-email"><%= currentUserEmail %></p>
      <p
        class="profile-username <%= postsArr[0].userId.username ? 'premium-username' : '' %>"
      >
        <% if (postsArr[0].userId.username) { %> <%= postsArr[0].userId.username
        %> <% if(postsArr[0].userId.isPremium){ %>
        <span
          class="material-symbols-outlined icon-down-5 animate__animated animate__heartBeat animate__infinite infinite"
        >
          star
        </span>
        <% } %> <% } %>
      </p>
    </div>
    <div class="username-premium-btns">
      <a class="right ml-10" href="/admin/username">Set username</a>
      <% if(postsArr[0].userId.isPremium){ %>
      <a class="right" href="/admin/premium-details">Check premium status</a>
      <% } else{%>
      <a class="right" href="/admin/premium">Buy premium</a>
      <% } %>
    </div>
  </div>
  <div class="post-container">
    <% for(let post of postsArr) { %>
    <div class="post-box">
      <img
        class="post-img"
        src="<%= '/' + post.imgUrl %>"
        alt="<%= post.title %>"
      />
      <a href="/post/<%= post._id %>" class="post-title"><%= post.title %></a>
      <hr />
      <p class="post-desc">
        <%= post.description.substr(0, 100) %><% if(post.description.length >
        80){ %>...<% } %>
      </p>
    </div>
    <% } %>
  </div>
  <hr />
  <div class="pagination">
    <!-- previous  -->
    <% if(hasPreviousPage){ %>
    <a href="/admin/profile?page=<%= previousPage %>"
      >Previous Page (<%= previousPage %>)</a
    >
    <% } %>
    <!-- next -->
    <% if(hasNextPage){ %>
    <a class="ml-10" href="/admin/profile?page=<%= nextPage %>"
      >Next Page (<%= nextPage %>)</a
    >
    <% } %>
  </div>
</section>
<%- include("../includes/foot") %>
