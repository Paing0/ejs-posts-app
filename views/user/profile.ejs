<%- include("../includes/head") %> <% if(postsArr.length > 0 ){ %>
<section class="profile mb-50">
  <div class="user-profile">
    <div class="flex-align-center flex-column">
      <% if(postsArr[0].userId.profile_imgUrl && postsArr[0].userId.isPremium)
      {%> <img class="profile-photo" src="<%= "/" +
      postsArr[0].userId.profile_imgUrl %>" alt="<%= postsArr[0].userId.username
      %>" /> <% } else { %>
      <span class="material-symbols-outlined material-account-circle-f6">
        account_circle
      </span>
      <% } %>
      <p class="profile-email"><%= currentUserEmail %></p>
      <p
        class="profile-username <%= postsArr[0].userId.username ? 'premium-username' : '' %>"
      >
        <% if (postsArr[0].userId.username) { %> <%= postsArr[0].userId.username
        %> <% if(postsArr[0].userId.isPremium){ %>
        <span
          class="material-symbols-outlined icon-down-5 animate__animated animate__heartBeat animate__infinite infinite"
        >
          star
        </span>
        <% } %> <% } %>
      </p>
    </div>
    <div class="username-pfp-premiun-btns-container">
      <% if(postsArr[0].userId.username) { %>
      <a class="username-pfp-premium-btns" href="/admin/username">
        Update username
      </a>
      <% } else{%>
      <a class="username-pfp-premium-btns" href="/admin/username">
        Set username
      </a>
      <% } %> <% if(postsArr[0].userId.isPremium){ %>
      <a class="username-pfp-premium-btns" href="/admin/profile-image"
        >Set profile picture
      </a>
      <a class="username-pfp-premium-btns" href="/admin/premium-details"
        >Check premium status
      </a>
      <% } else{%>
      <a class="username-pfp-premium-btns" href="/admin/premium">Buy premium</a>
      <% } %>
    </div>
  </div>
  <div class="post-container mb-50">
    <% for(let post of postsArr) { %>
    <div class="post-box">
      <img
        class="post-img"
        src="<%= '/' + post.imgUrl %>"
        alt="<%= post.title %>"
      />
      <a href="/post/<%= post._id %>" class="post-title"><%= post.title %></a>
      <hr />
      <p class="post-desc">
        <%= post.description.substr(0, 100) %><% if(post.description.length >
        80){ %>...<% } %>
      </p>
    </div>
    <% } %>
  </div>
  <hr />
  <div class="pagination">
    <!-- previous  -->
    <% if(hasPreviousPage){ %>
    <a href="/admin/profile?page=<%= previousPage %>"
      >Previous Page (<%= previousPage %>)</a
    >
    <% } %>
    <!-- next -->
    <% if(hasNextPage){ %>
    <a class="ml-10" href="/admin/profile?page=<%= nextPage %>"
      >Next Page (<%= nextPage %>)</a
    >
    <% } %>
  </div>
</section>
<% }else{ %>
<section class="profile-no-post">
  <h1>Create a new post first</h1>
  <a href="/admin/create-post">Create Post</a>
</section>
<% } %> <%- include("../includes/foot") %>
